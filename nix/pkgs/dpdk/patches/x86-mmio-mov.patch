+/*
+ * A plain volatile access leaves the instruction to the compiler, which may
+ * use any encoding of a load or store: an SSE movd of a value it computed in
+ * a vector register, or a VEX broadcast folded from a load. On a device that
+ * a hypervisor emulates, every access to a BAR traps, and KVM's instruction
+ * emulator rejects most vector encodings, so the guest takes #UD instead.
+ * Each access is therefore a single mov through a general-purpose register.
+ */
+
+static __rte_always_inline uint8_t
+rte_read8_relaxed(const volatile void *addr)
+{
+	uint8_t val;
+	asm volatile("movb %1, %0" : "=q" (val) : "m" (*(const volatile uint8_t *)addr));
+	return val;
+}
+
+static __rte_always_inline uint16_t
+rte_read16_relaxed(const volatile void *addr)
+{
+	uint16_t val;
+	asm volatile("movw %1, %0" : "=r" (val) : "m" (*(const volatile uint16_t *)addr));
+	return val;
+}
+
+static __rte_always_inline uint32_t
+rte_read32_relaxed(const volatile void *addr)
+{
+	uint32_t val;
+	asm volatile("movl %1, %0" : "=r" (val) : "m" (*(const volatile uint32_t *)addr));
+	return val;
+}
+
+static __rte_always_inline uint64_t
+rte_read64_relaxed(const volatile void *addr)
+{
+	uint64_t val;
